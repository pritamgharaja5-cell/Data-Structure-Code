#include <math.h>

int main() {
    double a, b, c, discriminant, root1, root2;
    double realPart, imaginaryPart;

    printf("Enter coefficients a, b and c: ");
    scanf("%lf %lf %lf", &a, &b, &c);

    if (a == 0) {
        printf("This is not a quadratic equation.\n");
        return 0;
    }

    discriminant = b * b - 4 * a * c;

    if (discriminant > 0) {
        root1 = (-b + sqrt(discriminant)) / (2 * a);
        root2 = (-b - sqrt(discriminant)) / (2 * a);
        printf("Two real and distinct roots: %.2lf and %.2lf\n", root1, root2);
    } else if (discriminant == 0) {
        root1 = -b / (2 * a);
        printf("Two equal real roots: %.2lf and %.2lf\n", root1, root1);
    } else {
        realPart = -b / (2 * a);
        imaginaryPart = sqrt(-discriminant) / (2 * a);
        printf("Complex roots: %.2lf + %.2lfi and %.2lf - %.2lfi\n",
               realPart, imaginaryPart, realPart, imaginaryPart);
    }

    return 0;
}
#include <stdio.h>
#include <stdlib.h>

int main() {
    int n, i, j;
    int *isPrime;

    printf("Enter the upper limit: ");
    scanf("%d", &n);

    if (n < 2) {
        printf("There are no prime numbers in this range.\n");
        return 0;
    }

    isPrime = (int *)malloc((n + 1) * sizeof(int));

    for (i = 0; i <= n; i++)
        isPrime[i] = 1;

    isPrime[0] = isPrime[1] = 0;

    for (i = 2; i * i <= n; i++) {
        if (isPrime[i]) {
            for (j = i * i; j <= n; j += i)
                isPrime[j] = 0;
        }
    }

    printf("Prime numbers from 2 to %d:\n", n);
    for (i = 2; i <= n; i++) {
        if (isPrime[i])
            printf("%d ", i);
    }
    printf("\n");

    free(isPrime);
    return 0;
}
#include <stdio.h>
#include <string.h>

char GETCHAR(char str[], int n) {
    return str[n];
}

void PUTCHAR(char str[], int n, char c) {
    str[n] = c;
}

int LENGTH(char str[]) {
    int i = 0;
    while (str[i] != '\0')
        i++;
    return i;
}

int POS(char str1[], char str2[]) {
    char *p = strstr(str1, str2);
    if (p == NULL)
        return -1;
    return (int)(p - str1);
}

void CONCAT(char str1[], char str2[]) {
    strcat(str1, str2);
}

void SUBSTRING(char str1[], int start, int m, char result[]) {
    int i;
    for (i = 0; i < m && str1[start + i] != '\0'; i++)
        result[i] = str1[start + i];
    result[i] = '\0';
}

void DELETE(char str[], int start, int m) {
    int len = LENGTH(str);
    int i;

    if (start < 0 || start >= len || m <= 0)
        return;

    if (start + m > len)
        m = len - start;

    for (i = start; i + m <= len; i++)
        str[i] = str[i + m];
}

void INSERT(char str1[], char str2[], int pos) {
    int len1 = LENGTH(str1);
    int len2 = LENGTH(str2);
    int i;

    if (pos < 0 || pos > len1)
        return;

    for (i = len1; i >= pos; i--)
        str1[i + len2] = str1[i];

    for (i = 0; i < len2; i++)
        str1[pos + i] = str2[i];
}

int COMPARE(char str1[], char str2[]) {
    return strcmp(str1, str2);
}

int main() {
    char str1[100] = "DataStructure";
    char str2[50] = "Lab";
    char result[50];

    printf("GETCHAR(str1, 4): %c\n", GETCHAR(str1, 4));

    PUTCHAR(str1, 4, 'X');
    printf("After PUTCHAR: %s\n", str1);

    printf("LENGTH(str1): %d\n", LENGTH(str1));
    printf("POS(str1, \"Structure\"): %d\n", POS(str1, "Structure"));

    CONCAT(str1, str2);
    printf("After CONCAT: %s\n", str1);

    SUBSTRING(str1, 0, 4, result);
    printf("SUBSTRING(str1, 0, 4): %s\n", result);

    DELETE(str1, 0, 4);
    printf("After DELETE: %s\n", str1);

    INSERT(str1, "Data", 0);
    printf("After INSERT: %s\n", str1);

    printf("COMPARE(\"abc\", \"abd\"): %d\n", COMPARE("abc", "abd"));

    return 0;
}
