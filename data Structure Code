#include <stdio.h>

void swap(char *a, char *b) {
    char temp = *a;
    *a = *b;
    *b = temp;
}

void permute(char str[], int left, int right) {
    int i;
    if (left == right) {
        printf("%s\n", str);
        return;
    }

    for (i = left; i <= right; i++) {
        swap(&str[left], &str[i]);
        permute(str, left + 1, right);
        swap(&str[left], &str[i]);
    }
}

int main() {
    char str[20];
    int n;

    printf("Enter a string: ");
    scanf("%19s", str);

    n = 0;
    while (str[n] != '\0')
        n++;

    printf("All permutations are:\n");
    permute(str, 0, n - 1);

    return 0;
}
