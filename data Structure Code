int main() {
    char str[300];
    int pos, count, len, i;

    printf("Enter the string: ");
    fgets(str, sizeof(str), stdin);
    str[strcspn(str, "\n")] = '\0';

    printf("Enter starting position (0-based): ");
    scanf("%d", &pos);

    printf("Enter number of characters to delete: ");
    scanf("%d", &count);

    len = strlen(str);

    if (pos < 0 || pos >= len || count < 0) {
        printf("Invalid input.\n");
        return 0;
    }

    if (pos + count > len)
        count = len - pos;

    for (i = pos; i + count <= len; i++)
        str[i] = str[i + count];

    printf("String after deletion: %s\n", str);

    return 0;
}
